# ── Database ────────────────────────────────────────────────────────────────
# Main (dev) database used by `npm run dev` and `npm run db:seed`.
DATABASE_URL="postgresql://user:password@localhost:5432/scheduling"
# Separate database for integration + e2e tests. MUST differ from DATABASE_URL:
# the e2e global setup and `npm run db:test:seed` TRUNCATE it.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/scheduling_test"
# Optional: non-pooled URL for `prisma migrate` if your provider's pooler
# doesn't support migrations (falls back to DATABASE_URL).
# MIGRATE_DATABASE_URL=""
# TEST_MIGRATE_DATABASE_URL=""

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL (used in email links and auth callbacks).
APP_URL="http://localhost:3000"

# ── Secrets (required in production; dev falls back to insecure placeholders) ─
# Generate each with: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# Server secret for clock-in PIN HMAC-SHA256 (Spec §7.1). Changing it
# invalidates every stored PIN.
PIN_HMAC_SECRET=""

# ── Email (optional) ────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are stored in EmailLog, printed to the console
# and viewable at /dev/emails (development only).
RESEND_API_KEY=""
# Signing secret of the Resend webhook (delivered / bounced / complained).
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Shiftwise <no-reply@example.com>"

# ── Testing ─────────────────────────────────────────────────────────────────
# Set to 1 to disable rate limiting (the e2e web server sets this itself).
# DISABLE_RATE_LIMIT="0"
# E2E_PORT="3100"
